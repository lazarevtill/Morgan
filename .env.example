# Morgan configuration — all variables are MORGAN_-prefixed.
# Defaults shown are the code defaults; uncomment/override only what you need.
#
# Where to put this file: ~/.config/morgan/.env ($XDG_CONFIG_HOME/morgan/.env) is read from
# every working directory, which is what the `morgan` CLI needs. A ./.env in the current
# directory is read after it and overrides it, and real environment variables override both.

# --- Identity ---
MORGAN_OWNER_USER_ID=owner

# --- The model server: any OpenAI-compatible endpoint (llama-server by default) ---
# The localhost value is a dev convenience. The expected topology is a remote llama-server on
# a GPU box, reached over an overlay network from every machine you use.
MORGAN_LLM_ENDPOINT=http://localhost:8081/v1
MORGAN_LLM_MODEL=qwen2.5:7b
MORGAN_EMBEDDING_MODEL=mxbai-embed-large
# Must match the embedding model's output dimension (mxbai-embed-large 1024,
# nomic-embed-text 768). Checked against a live embed() call at startup.
MORGAN_EMBEDDING_DIM=1024
# OUTBOUND: the key Morgan presents TO the model server (llama-server's --api-key). Empty by
# default; most homelab servers run without one.
# MORGAN_LLM_API_KEY=
# Timeout (seconds) for chat + embedding calls, sized for a network hop under GPU load.
MORGAN_LLM_TIMEOUT_SECONDS=120.0
# How consolidation asks for JSON: json_schema (native constrained decoding; llama-server and
# Ollama /v1 support it), json_object, or prompted.
MORGAN_LLM_JSON_MODE=json_schema
# 'provider' calls the embedding endpoint above. 'hash' is a deterministic stub so the memory
# commands run with no model server at all.
MORGAN_EMBEDDING_BACKEND=provider

# --- The one database ---
# A per-user location that is the same from every working directory. `~` is expanded.
# MORGAN_DATA_DIR=~/.local/share/morgan

# --- The MCP listener (morgan-mcp --transport http; stdio needs neither) ---
# INBOUND: the bearer token MCP clients present to Morgan. The placeholder means "no key":
# allowed on loopback only. Binding any other host (an overlay address, or 0.0.0.0 in a
# container) requires a real key, because these tools include forget().
MORGAN_API_KEY=change-me
MORGAN_MCP_HOST=127.0.0.1
MORGAN_MCP_PORT=8090
