# Morgan configuration — all variables are MORGAN_-prefixed.
# Defaults shown are the code defaults; uncomment/override only what you need.
#
# Where to put this file: ~/.config/morgan/.env ($XDG_CONFIG_HOME/morgan/.env) is read from
# every working directory, which is what the `morgan` CLI needs. A ./.env in the current
# directory is read after it and overrides it, and real environment variables override both.

# --- Identity ---
MORGAN_OWNER_USER_ID=owner

# --- The model server: any OpenAI-compatible endpoint (llama-server by default) ---
# The localhost value is a dev convenience. The expected topology is a remote llama-server on
# a GPU box, reached over an overlay network from every machine you use.
MORGAN_LLM_ENDPOINT=http://localhost:8081/v1
MORGAN_LLM_MODEL=qwen2.5:7b
MORGAN_EMBEDDING_MODEL=mxbai-embed-large
# Where embeddings are requested. Leave empty when one server answers both chat and
# /embeddings. Set it when the chat server has embeddings disabled -- llama-server loads one
# model per process, so an embedding model is a second server at a second address.
# MORGAN_EMBEDDING_ENDPOINT=http://localhost:8082/v1
# Must match the embedding model's output dimension (mxbai-embed-large 1024,
# nomic-embed-text 768). Checked against a live embed() call at startup.
MORGAN_EMBEDDING_DIM=1024
# The first embedding request a process sends also carries five fixed strings, and their
# vectors must reach this cosine against the fingerprint the database recorded for its active
# embedding space; a model that answers below it is refused by name. 0.995 is measured: the
# worst first percentile over 500 re-embedded rows under seven conditions was 0.99860.
MORGAN_EMBEDDING_FINGERPRINT_TOLERANCE=0.995
# When no fingerprint is recorded yet, that request also re-embeds this many stored memories
# (at least 1); the fingerprint is recorded only if their fresh vectors match the stored ones.
MORGAN_EMBEDDING_FINGERPRINT_SAMPLE_ROWS=5
# OUTBOUND: the key Morgan presents TO the model server (llama-server's --api-key). Empty by
# default; most homelab servers run without one.
# MORGAN_LLM_API_KEY=
# Timeout (seconds) for one chat call, sized for a network hop under GPU load. Embedding
# calls do not use it; they have the budgets below.
MORGAN_LLM_TIMEOUT_SECONDS=120.0
# An embedding call that fails in a way that may pass is retried, within a budget that bounds
# the call's wall time. A host that accepted the connection and then answered slowly, with a
# 5xx or a 429, or dropped it -- as a cold host loading its model does -- is waited on this long
# for a command or a tool call...
MORGAN_EMBEDDING_RETRY_BUDGET_SECONDS=60.0
# ...and this long for `morgan import`, which has thousands of calls to make.
MORGAN_EMBEDDING_IMPORT_RETRY_BUDGET_SECONDS=600.0
# A host that cannot be connected to at all (refused, DNS, connect timeout) is off or wrongly
# addressed, and is given up on after this long.
MORGAN_EMBEDDING_UNREACHABLE_BUDGET_SECONDS=5.0
# The wait before the first retry, doubling before each next one.
MORGAN_EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
# The longest one embedding attempt may take, and never longer than what is left of the
# budget. 50 s covers a cold host's first load of the model from disk (43 s measured).
MORGAN_EMBEDDING_TIMEOUT_SECONDS=50.0
# How consolidation asks for JSON: json_schema (native constrained decoding; llama-server and
# Ollama /v1 support it), json_object, or prompted.
MORGAN_LLM_JSON_MODE=json_schema
# 'provider' calls the embedding endpoint above. 'hash' is a deterministic stub so the memory
# commands run with no model server at all.
MORGAN_EMBEDDING_BACKEND=provider
# How far the best match must stand above the weaker results the same query pulled up
# before recall returns anything at all. Unset means no floor: every question is answered,
# even one this brain has nothing to say about. The value belongs to the embedding model:
# 0.11 for Qwen3-Embedding-0.6B, measured on the bundled probes and on a real archive. For
# another model, `pytest tests/memory_quality --live` prints what each threshold keeps and
# silences.
# MORGAN_RECALL_FLOOR_MARGIN=

# --- Project classification (surfaces/cli/project.py::classify). Phase 0 only stores these;
# the disk walk over MORGAN_CODE_ROOTS is phase 1a. Empty here: set your own in
# ~/.config/morgan/.env, never in this repository. ---
# Repository roots the phase-1a walk will scan, comma separated. `~` is expanded.
MORGAN_CODE_ROOTS=
# How many directory levels below each root that walk descends looking for a .git.
MORGAN_CODE_ROOT_DEPTH=2
# fnmatch globs, comma separated, a remote's host or whole URL must match to classify a
# project `work` rather than `personal`.
MORGAN_WORK_REMOTE_GLOBS=

# --- The one database ---
# A per-user location that is the same from every working directory. `~` is expanded.
# MORGAN_DATA_DIR=~/.local/share/morgan
# Where `morgan snapshot` writes its VACUUM INTO copies. Empty derives it from
# MORGAN_DATA_DIR: {MORGAN_DATA_DIR}/snapshots.
# MORGAN_SNAPSHOT_DIR=~/.local/share/morgan/snapshots
# PRAGMA busy_timeout (milliseconds): how long a writer waits on another process's lock
# before giving up. Threaded through explicitly where a wait longer than the default might be
# needed, such as `morgan snapshot`'s VACUUM INTO against the live database.
MORGAN_DB_BUSY_TIMEOUT_MS=5000

# --- The MCP listener (morgan-mcp --transport http; stdio needs neither) ---
# INBOUND: the bearer token MCP clients present to Morgan. The placeholder means "no key":
# allowed on loopback only. Binding any other host (an overlay address, or 0.0.0.0 in a
# container) requires a real key, because these tools include forget().
MORGAN_API_KEY=change-me
MORGAN_MCP_HOST=127.0.0.1
MORGAN_MCP_PORT=8090
