# Morgan configuration — all variables are MORGAN_-prefixed.
# Uncommented values are the code defaults; a commented line shows an example or the derived
# default, and takes effect only once uncommented. Override only what you need.
#
# Where to put this file: ~/.config/morgan/.env ($XDG_CONFIG_HOME/morgan/.env) is read from
# every working directory, which is what the `morgan` CLI needs. The CLI reads a ./.env in the
# current directory after it, which overrides it; morgan-mcp reads this file only, because its
# working directory is the client's. Real environment variables override every file.

# --- Identity ---
MORGAN_OWNER_USER_ID=owner

# --- The model server: any OpenAI-compatible endpoint (llama-server by default) ---
# The localhost value is a dev convenience. The expected topology is a remote llama-server on
# a GPU box, reached over an overlay network from every machine you use.
MORGAN_LLM_ENDPOINT=http://localhost:8081/v1
MORGAN_LLM_MODEL=qwen2.5:7b
MORGAN_EMBEDDING_MODEL=mxbai-embed-large
# Where embeddings are requested. Leave empty when one server answers both chat and
# /embeddings. Set it when the chat server has embeddings disabled -- llama-server loads one
# model per process, so an embedding model is a second server at a second address.
# MORGAN_EMBEDDING_ENDPOINT=http://localhost:8082/v1
# Must match the embedding model's output dimension (mxbai-embed-large 1024,
# nomic-embed-text 768). A new database's vector table is created at this width. An open
# refuses a database whose active embedding space has another; under the provider backend, a
# writable database with no space yet is also refused when its vector table has another.
# Nothing is embedded to check it.
MORGAN_EMBEDDING_DIM=1024
# The first embedding request a process sends also carries five fixed strings, and their
# vectors must reach this cosine against the fingerprint the database recorded for its active
# embedding space; a model that answers below it is refused by name. The value belongs to the
# embedding model: 0.995 for qwen3-embedding:8b (4,096 wide), where the worst first percentile
# over 500 re-embedded rows under seven conditions was 0.99860. Other models are unmeasured.
MORGAN_EMBEDDING_FINGERPRINT_TOLERANCE=0.995
# When no fingerprint is recorded yet, that request also re-embeds this many stored memories
# (at least 1); the fingerprint is recorded only if their fresh vectors match the stored ones.
MORGAN_EMBEDDING_FINGERPRINT_SAMPLE_ROWS=5
# How many memories `morgan import` stores before it re-checks the active embedding space
# against its recorded fingerprint, and once more at the end for the rest. A model that
# starts answering wrong mid-import is caught within one stretch this size, not just at the
# end when every memory since is a suspect. Counts only memories actually embedded and
# stored; an already-stored, unchanged piece costs no embedding and does not count.
MORGAN_IMPORT_CANARY_EVERY=50
# How many stored vectors `doctor --vectors` re-embeds and compares against what is stored,
# spread evenly across the active embedding space's table.
MORGAN_VECTOR_AUDIT_SAMPLE_ROWS=180
# OUTBOUND: the key Morgan presents TO the model server (llama-server's --api-key). Empty by
# default; most homelab servers run without one.
# MORGAN_LLM_API_KEY=
# OUTBOUND: the key Morgan presents TO the embedding server, when MORGAN_EMBEDDING_ENDPOINT
# addresses a separate one -- sent instead of MORGAN_LLM_API_KEY, so the chat credential
# never reaches a host it was never meant for. Without a separate endpoint, embeddings go to
# the chat host and carry MORGAN_LLM_API_KEY, as they must. Empty by default.
# MORGAN_EMBEDDING_API_KEY=
# Timeout (seconds) for one chat call, sized for a network hop under GPU load. Embedding
# calls do not use it; they have the budgets below.
MORGAN_LLM_TIMEOUT_SECONDS=120.0
# An embedding call that fails in a way that may pass is retried, within a budget that bounds
# the call's wall time. A host that accepted the connection and then answered slowly, with a
# 5xx or a 429, or dropped it -- as a cold host loading its model does -- is waited on this long
# for a command or a tool call (a 501 is not retried: that server serves no embeddings).
MORGAN_EMBEDDING_RETRY_BUDGET_SECONDS=60.0
# ...and this long for `morgan import`, which has thousands of calls to make.
MORGAN_EMBEDDING_IMPORT_RETRY_BUDGET_SECONDS=600.0
# A host that cannot be connected to at all (refused, DNS, connect timeout) is off or wrongly
# addressed, and is given up on after this long.
MORGAN_EMBEDDING_UNREACHABLE_BUDGET_SECONDS=5.0
# The wait before the first retry, doubling before each next one. A retry is made only while
# this much of the budget is left for it, so no retry runs the call past its budget.
MORGAN_EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
# The longest that doubling wait grows to, so a long budget keeps asking at a steady rate.
MORGAN_EMBEDDING_RETRY_BACKOFF_MAX_SECONDS=2.0
# The longest one embedding attempt may take, and never longer than what is left of the
# budget. 50 s covers a cold host's first load of the model from disk (43 s measured).
MORGAN_EMBEDDING_TIMEOUT_SECONDS=50.0
# How long `morgan doctor` waits for each model server's answer before calling it unreachable.
# A cold host loading its model answers, just late; this waits for it.
MORGAN_DOCTOR_PROBE_TIMEOUT_SECONDS=60.0
# A server that answers `morgan doctor` after more than this many seconds is reported slow,
# not reachable: it works, and its next answer will come quicker.
MORGAN_DOCTOR_SLOW_AFTER_SECONDS=2.0
# How consolidation asks for JSON: json_schema (native constrained decoding; llama-server and
# Ollama /v1 support it), json_object, or prompted.
MORGAN_LLM_JSON_MODE=json_schema
# 'provider' calls the embedding endpoint above. 'hash' is a deterministic stub so the memory
# commands run with no model server at all.
MORGAN_EMBEDDING_BACKEND=provider
# How far the best match must stand above the weaker results the same query pulled up
# before recall returns anything at all. Unset means no floor: every question is answered,
# even one this brain has nothing to say about. The value belongs to the embedding model:
# 0.08 for qwen3-embedding:8b, measured on a 3,010-memory archive with 128 labelled
# questions (docs/measurements/2026-09-phase0-baseline.md); 0.11 for Qwen3-Embedding-0.6B,
# measured on the bundled probes and on a real archive. For another model,
# `pytest tests/memory_quality --live` prints what each threshold keeps and silences.
# MORGAN_RECALL_FLOOR_MARGIN=

# --- Project classification (surfaces/cli/project.py::classify). `morgan remember`, `ask`
# and `consolidate`, run inside a git repository and with no --project, record that project's
# classification, remote and root; `morgan doctor` prints the classification and lists each
# root, marking one that is not a directory. Nothing walks the roots yet. Empty here: set your
# own in ~/.config/morgan/.env, never in this repository. ---
# Repository roots, comma separated. `~` is expanded.
MORGAN_CODE_ROOTS=
# How many directory levels below each root a walk descends looking for a .git.
MORGAN_CODE_ROOT_DEPTH=2
# Globs, comma separated: classify() calls a project `work` when its remote matches one,
# `personal` when none does, `unclassified` when it has no remote (the remote is `origin`, or
# the sole remote when a repository has exactly one). A glob without `*` must equal the
# remote's host; one with `*` is matched (fnmatch) against the host, then the URL.
MORGAN_WORK_REMOTE_GLOBS=

# --- The secret gate (memory/secrets): every threshold, keyword list, BIN range, epoch window
# and placeholder the rules read. Nothing is fixed in code. ---
# A token this long or longer is measured for entropy, and redacted at or above this many
# Shannon bits per character. Uniform hex tops out at 4.0: a hex secret is caught only through
# an assignment's context.
MORGAN_GATE_ENTROPY_MIN_LENGTH=20
MORGAN_GATE_ENTROPY_THRESHOLD=4.2
# How far (characters, on the same line) a Russian identifier's keyword may sit from it.
MORGAN_GATE_CONTEXT_CHARS=40
# A text longer than this is scanned in windows overlapping by the second value, so a token
# straddling a window boundary is whole in one of them.
MORGAN_GATE_WINDOW_CHARS=65536
MORGAN_GATE_WINDOW_OVERLAP_CHARS=256
# Card BIN prefixes and ranges: a Luhn-valid number under one is redacted without a keyword.
MORGAN_GATE_CARD_BINS=4,51-55,2200-2204,2221-2720
# A number with no keyword near it that parses as epoch seconds or milliseconds in these years
# is a timestamp, not an identifier.
MORGAN_GATE_EPOCH_YEARS=2000-2100
# The keywords a Russian identifier must sit beside (comma separated, matched without regard
# to case, at least one required). A keyword matches only at a word's start, never glued to a
# preceding letter ("INN" in "dinner" does not gate); an ASCII keyword also ends at a word's
# end, with an optional plural "s" ("card" in "cardinal" does not gate, "cards" does); a
# Cyrillic keyword stays open on the right, since Russian inflects it ("карт" also matches
# "карта", "карты").
MORGAN_GATE_KEYWORDS_INN=ИНН,INN
MORGAN_GATE_KEYWORDS_SNILS=СНИЛС,SNILS
MORGAN_GATE_KEYWORDS_OGRN=ОГРН,OGRN
MORGAN_GATE_KEYWORDS_CARD=карт,card,PAN,Mir,Visa,Mastercard
MORGAN_GATE_KEYWORDS_PASSPORT=паспорт,passport
MORGAN_GATE_KEYWORDS_PHONE=тел,phone,телефон,моб
# Assignment values that are placeholders (matched whole, case aside), placeholder shapes
# (fnmatch patterns, case aside) and the prefixes a templated value starts with. None is a
# secret.
MORGAN_GATE_PLACEHOLDER_VALUES=change-me,changeme,xxx
MORGAN_GATE_PLACEHOLDER_SHAPES=your-*-here
MORGAN_GATE_PLACEHOLDER_PREFIXES=${,<,$(,%(,{{

# --- The one database ---
# A per-user location that is the same from every working directory. `~` is expanded.
# MORGAN_DATA_DIR=~/.local/share/morgan
# The database as a sqlite:/// URL. Empty derives it from MORGAN_DATA_DIR:
# sqlite:///{MORGAN_DATA_DIR}/morgan.db.
# MORGAN_TEMPORAL_DB_URL=
# Where `morgan snapshot`, `migrate`, `forget` and `restore` write their VACUUM INTO copies.
# Empty derives it from MORGAN_DATA_DIR: {MORGAN_DATA_DIR}/snapshots. Morgan never prunes it.
# MORGAN_SNAPSHOT_DIR=~/.local/share/morgan/snapshots
# PRAGMA busy_timeout (milliseconds): how long a connection waits on another process's lock
# before giving up with "database is locked". Every connection Morgan writes through waits this
# long -- the memory commands, every morgan-mcp tool call, `morgan snapshot`, `restore`,
# `migrate` and the snapshot `forget` takes -- and so does `doctor`'s read-only one.
MORGAN_DB_BUSY_TIMEOUT_MS=5000

# --- The MCP listener (morgan-mcp --transport http; stdio needs neither) ---
# INBOUND: the bearer token MCP clients present to Morgan. The placeholder means "no key":
# allowed on loopback only. Binding any other host (an overlay address, or 0.0.0.0 in a
# container) requires a real key, because these tools include forget().
MORGAN_API_KEY=change-me
MORGAN_MCP_HOST=127.0.0.1
MORGAN_MCP_PORT=8090
