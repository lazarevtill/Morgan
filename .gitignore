# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Environment files: never commit a real one.
.env
.env.*
!.env.example

# Runtime data only. Packaged data under morgan_brain/**/data/ must ship.
/data/
*.log
*.pid

# The owner's own chat export, which `morgan import` reads, and the pre-cut code some
# checkouts keep beside it. Both are local: the export is private, and the old code is at
# the legacy tags. Root-anchored, so docs/archive/ stays tracked.
/conversations.json
/archive/

# Editors and machine-local settings. settings.local.json is where credentials may
# legitimately live; it was tracked once, and leaked a key.
.idea/
.vscode/
.claude/settings.local.json
