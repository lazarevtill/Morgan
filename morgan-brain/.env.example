# morgan-brain configuration — all variables are MORGAN_-prefixed.
# Defaults shown are the code defaults; uncomment/override only what you need.

# --- Identity / auth (single-owner now; multi-tenant-ready) ---
MORGAN_OWNER_USER_ID=owner
# SECURITY: /api/* requires this as a Bearer token when a key is set. The default
# 'change-me' leaves /api/* open for local dev — SET A REAL KEY before any remote exposure.
MORGAN_API_KEY=change-me

# --- Models (any OpenAI-compatible base_url; Ollama example) ---
MORGAN_LLM_ENDPOINT=http://localhost:11434/v1
MORGAN_LLM_MODEL=qwen2.5:7b          # default 'strong' role
MORGAN_LLM_FAST_MODEL=qwen2.5:7b     # 'fast' role
MORGAN_EMBEDDING_MODEL=qwen3-embedding:4b

# Provider/role wiring (advanced — defaults are derived from MORGAN_LLM_* above).
# role_bindings maps a logical role to an ordered list of "provider:model" fallbacks.
# Add a bigger 'reflection' model for the optimizer; the 'judge' should be a DIFFERENT
# model family than the assistant (eval bias). JSON values.
# MORGAN_ROLE_BINDINGS={"strong":["ollama:qwen2.5:7b"],"fast":["ollama:qwen2.5:7b"],"reflection":["ollama:qwen2.5:32b"]}
# MORGAN_PROVIDERS={"ollama":{"base_url":"http://localhost:11434/v1","api_key":"ollama"}}
# Optional YAML with per-model capability overrides:
# MORGAN_MODELS_YAML=

# --- Stores ---
# data_dir is where the single durable database (morgan.db) and workspace files live.
MORGAN_DATA_DIR=./data
MORGAN_QDRANT_URL=http://localhost:6333
MORGAN_REDIS_URL=redis://localhost:6379/0
# Leave unset to derive from MORGAN_DATA_DIR (sqlite:///{data_dir}/morgan.db). Every store
# (facts, vectors, FTS, entities, episodics, signals, session history) shares this one file.
# MORGAN_TEMPORAL_DB_URL=sqlite:///./data/morgan.db
MORGAN_WORKSPACE_PATH=./data/workspace

# --- Event bus: inproc | redis (redis enables multi-process / Redis Streams) ---
MORGAN_EVENT_BUS=inproc

# --- Vector backend: sqlite | memory | qdrant ---
# 'sqlite' (default) = persistent SqliteVectorIndex, shares morgan.db, no external deps.
# 'memory' = ephemeral InMemoryVectorIndex (tests/scratch only). 'qdrant' = persistent,
# requires Qdrant at MORGAN_QDRANT_URL.
MORGAN_VECTOR_BACKEND=sqlite
# Must match the embedding model's output dim (qwen3-embedding:4b→2560, nomic-embed-text→768).
MORGAN_EMBEDDING_DIM=1024

# --- Personalization ---
# Fraction of the context window budgeted for injected traits (0.0–1.0).
MORGAN_PERSONALIZATION_BUDGET=0.15

# --- Learning lifecycle (champion prompt registry + GEPA optimizer) ---
MORGAN_LEARNING_BACKEND=local        # 'local' (SQLite, dependency-light) or 'mlflow' (needs [learning])
# Override the packaged golden-set path (empty = bundled morgan_brain/eval/data/golden_set.json):
# MORGAN_EVAL_GOLDEN_PATH=

# --- Feature flags ---
MORGAN_ENABLE_SCHEDULING=false       # nightly consolidation + optimizer in the learning-worker
