# morgan-brain configuration — all variables are MORGAN_-prefixed.
# Defaults shown are the code defaults; uncomment/override only what you need.

# --- Identity / auth (single-owner now; multi-tenant-ready) ---
MORGAN_OWNER_USER_ID=owner
# SECURITY: /api/* requires this as a Bearer token when a key is set. The default
# 'change-me' leaves /api/* open for local dev — SET A REAL KEY before any remote exposure.
MORGAN_API_KEY=change-me

# --- Models (any OpenAI-compatible base_url; llama-server is the default provider) ---
# The default provider key is 'llamacpp' (llama-server's OpenAI-compatible /v1 port). The
# localhost value below is a zero-config DEV convenience for a fresh clone — it is NOT the
# expected production value. This deployment's real topology is a REMOTE llama-server on a
# GPU box, reached over an overlay network (e.g. NetBird) from every client machine; local
# loopback is the fallback (offline work, or a dev box running its own llama-server). Point
# this at the remote box's address for normal operation.
MORGAN_LLM_ENDPOINT=http://localhost:8081/v1
MORGAN_LLM_MODEL=qwen2.5:7b          # default 'strong' role
MORGAN_LLM_FAST_MODEL=qwen2.5:7b     # 'fast' role
MORGAN_EMBEDDING_MODEL=mxbai-embed-large
# Outbound key Morgan presents TO the model server (llama-server's --api-key), NOT the same
# as MORGAN_API_KEY above (the INBOUND key clients present to Morgan — opposite direction).
# Empty by default: most homelab llama-server setups run without one.
# MORGAN_LLM_API_KEY=
# Request timeout (seconds) for LLM chat + embedding calls. Sized for a network hop under
# GPU load (remote llama-server over an overlay network), not a loopback socket.
MORGAN_LLM_TIMEOUT_SECONDS=120.0
# 'provider' (default) calls the configured embedding provider above. 'hash' selects a
# deterministic sha256 stub (no live model needed) — for the CLI and acceptance tests.
MORGAN_EMBEDDING_BACKEND=provider

# Provider/role wiring (advanced — defaults are derived from MORGAN_LLM_* above, bound to
# all four roles: strong/fast/judge/reflection). role_bindings maps a logical role to an
# ordered list of "provider:model" fallbacks. Add a bigger 'reflection' model for the
# optimizer; the 'judge' should be a DIFFERENT model family than the assistant (eval bias).
# JSON values. 'ollama' remains a fully supported non-default provider key for owners who
# haven't moved to llama.cpp.
# MORGAN_ROLE_BINDINGS={"strong":["llamacpp:qwen2.5:7b"],"fast":["llamacpp:qwen2.5:7b"],"judge":["llamacpp:qwen2.5:7b"],"reflection":["llamacpp:qwen2.5:32b"]}
# MORGAN_PROVIDERS={"llamacpp":{"base_url":"http://localhost:8081/v1","api_key":"llamacpp","timeout":120.0}}
# Optional YAML with per-model capability overrides:
# MORGAN_MODELS_YAML=

# --- Stores ---
# data_dir is where the single durable database (morgan.db) and workspace files live.
MORGAN_DATA_DIR=./data
MORGAN_QDRANT_URL=http://localhost:6333
MORGAN_REDIS_URL=redis://localhost:6379/0
# Leave unset to derive from MORGAN_DATA_DIR (sqlite:///{data_dir}/morgan.db). Every store
# (facts, vectors, FTS, entities, episodics, signals, session history) shares this one file.
# MORGAN_TEMPORAL_DB_URL=sqlite:///./data/morgan.db
MORGAN_WORKSPACE_PATH=./data/workspace

# --- Event bus: inproc | redis (redis enables multi-process / Redis Streams) ---
MORGAN_EVENT_BUS=inproc

# --- Vector backend: sqlite | memory | qdrant ---
# 'sqlite' (default) = persistent SqliteVectorIndex, shares morgan.db, no external deps.
# 'memory' = ephemeral InMemoryVectorIndex (tests/scratch only). 'qdrant' = persistent,
# requires Qdrant at MORGAN_QDRANT_URL.
MORGAN_VECTOR_BACKEND=sqlite
# Must match the embedding model's output dim (mxbai-embed-large→1024, nomic-embed-text→768,
# qwen3-embedding:4b→2560). composition.py probes this against a live embed() call at startup
# and raises on mismatch (skipped when MORGAN_EMBEDDING_BACKEND=hash).
MORGAN_EMBEDDING_DIM=1024

# --- Personalization ---
# Fraction of the context window budgeted for injected traits (0.0–1.0).
MORGAN_PERSONALIZATION_BUDGET=0.15

# --- Learning lifecycle (champion prompt registry + GEPA optimizer) ---
MORGAN_LEARNING_BACKEND=local        # 'local' (SQLite, dependency-light) or 'mlflow' (needs [learning])
# Override the packaged golden-set path (empty = bundled morgan_brain/eval/data/golden_set.json):
# MORGAN_EVAL_GOLDEN_PATH=
# Champion-preprompt self-modification gate. OFF by default: the current promotion logic is
# a bare `>` on a single scored run over a small golden set — too noisy to trust unattended.
MORGAN_ENABLE_CHAMPION_PROMOTION=false

# --- Feature flags ---
MORGAN_ENABLE_SCHEDULING=false       # nightly consolidation + optimizer in the learning-worker
